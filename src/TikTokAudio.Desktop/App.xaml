<Application x:Class="TikTokAudio.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <system:String x:Key="AppTitle">TikTok 直播音频工具</system:String>
        <system:String x:Key="WelcomeHeading">直播音频工作台</system:String>
        <system:String x:Key="WelcomeDescription">基础窗口已就绪。直播与音频功能将在后续版本提供。</system:String>
    </Application.Resources>
</Application>
