<Window x:Class="TikTokAudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource AppTitle}"
        Width="800" Height="480"
        MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Grid Margin="40">
        <Border Padding="32"
                Background="White"
                BorderBrush="#DFE5EC"
                BorderThickness="1"
                CornerRadius="12"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{StaticResource WelcomeHeading}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#172B4D"
                           TextWrapping="Wrap" />
                <TextBlock Text="{StaticResource WelcomeDescription}"
                           Margin="0,16,0,0"
                           FontSize="16"
                           Foreground="#4A596D"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
